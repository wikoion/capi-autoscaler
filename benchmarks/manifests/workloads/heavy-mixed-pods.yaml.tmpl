# Heavy mixed workload: 30% small, 30% medium, 25% large, 15% xlarge
# Tests bin-packing across all instance types including m5.xlarge
# Rendered by Jinja2 with: small_replicas, medium_replicas, large_replicas, xlarge_replicas, run_id
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bench-hmixed-small-{{ run_id }}
  namespace: benchmark-workload
  labels:
    app: benchmark-workload
    bench-profile: heavy-mixed
    bench-component: small
    bench-run: "{{ run_id }}"
spec:
  replicas: {{ small_replicas }}
  selector:
    matchLabels:
      app: benchmark-workload
      bench-profile: heavy-mixed
      bench-component: small
      bench-run: "{{ run_id }}"
  template:
    metadata:
      labels:
        app: benchmark-workload
        wikoion.dev/placement: managed
        bench-profile: heavy-mixed
        bench-component: small
        bench-run: "{{ run_id }}"
    spec:
      terminationGracePeriodSeconds: 0
      containers:
        - name: pause
          image: registry.k8s.io/pause:3.9
          resources:
            requests:
              cpu: 250m
              memory: 256Mi
            limits:
              cpu: 250m
              memory: 256Mi
