# Topology benchmark: zone + hostname spread constraints plus node affinity.
# Spread components are pinned to the zoned m6i.large pools so the tainted
# control-plane node never counts as an empty domain (would wedge DoNotSchedule).
# No podAntiAffinity yet - add once the controller translates it (ticket 4).
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bench-topo-zonespread-{{ run_id }}
  namespace: benchmark-workload
  labels:
    app: benchmark-workload
    bench-profile: {{ profile }}
    bench-component: zonespread
    bench-run: "{{ run_id }}"
spec:
  replicas: {{ zonespread_replicas }}
  selector:
    matchLabels:
      app: benchmark-workload
      bench-profile: {{ profile }}
      bench-component: zonespread
      bench-run: "{{ run_id }}"
  template:
    metadata:
      labels:
        app: benchmark-workload
        wikoion.dev/placement: managed
        bench-profile: {{ profile }}
        bench-component: zonespread
        bench-run: "{{ run_id }}"
    spec:
      terminationGracePeriodSeconds: 0
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: node.kubernetes.io/instance-type
                    operator: In
                    values:
                      - m6i.large
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: topology.kubernetes.io/zone
          whenUnsatisfiable: DoNotSchedule
          labelSelector:
            matchLabels:
              app: benchmark-workload
              bench-profile: {{ profile }}
              bench-component: zonespread
              bench-run: "{{ run_id }}"
      containers:
        - name: pause
          image: registry.k8s.io/pause:3.9
          resources:
            requests:
              cpu: 500m
              memory: 512Mi
            limits:
              cpu: 500m
              memory: 512Mi
---
