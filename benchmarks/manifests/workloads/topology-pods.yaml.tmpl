---
# Node-affinity-only service, same shape as prod-mix's: compute-optimised
# (but not the 4xl) OR a mid-tier memory-optimised node. Keeps the plain
# allowed-matrix path exercised alongside the spread constraints.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bench-topo-affinity-{{ run_id }}
  namespace: benchmark-workload
  labels:
    app: benchmark-workload
    bench-profile: {{ profile }}
    bench-component: affinity
    bench-run: "{{ run_id }}"
spec:
  replicas: {{ affinity_replicas }}
  selector:
    matchLabels:
      app: benchmark-workload
      bench-profile: {{ profile }}
      bench-component: affinity
      bench-run: "{{ run_id }}"
  template:
    metadata:
      labels:
        app: benchmark-workload
        wikoion.dev/placement: managed
        bench-profile: {{ profile }}
        bench-component: affinity
        bench-run: "{{ run_id }}"
    spec:
      terminationGracePeriodSeconds: 0
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: node.kubernetes.io/instance-type
                    operator: In
                    values:
                      - c5.xlarge
                      - c5.2xlarge
                      - c5.4xlarge
                  - key: node.kubernetes.io/instance-type
                    operator: NotIn
                    values:
                      - c5.4xlarge
              - matchExpressions:
                  - key: node.kubernetes.io/instance-type
                    operator: In
                    values:
                      - r5.xlarge
                      - r5.2xlarge
      containers:
        - name: pause
          image: registry.k8s.io/pause:3.9
          resources:
            requests:
              cpu: 1200m
              memory: 2Gi
            limits:
              cpu: 1200m
              memory: 2Gi
---
