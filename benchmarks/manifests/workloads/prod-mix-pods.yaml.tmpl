# Production-mix workload: 13 pod shapes spanning cpu-heavy, memory-heavy,
# non-round, and very large (4xlarge-only) sizes, plus an affinity-constrained
# service restricted to specific instance types via required node affinity.
# Exercises cost-aware bin-packing across heterogeneous instance families.
# Rendered by Jinja2 with: <component>_replicas for each component, run_id
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bench-pmix-tiny-{{ run_id }}
  namespace: benchmark-workload
  labels:
    app: benchmark-workload
    bench-profile: prod-mix
    bench-component: tiny
    bench-run: "{{ run_id }}"
spec:
  replicas: {{ tiny_replicas }}
  selector:
    matchLabels:
      app: benchmark-workload
      bench-profile: prod-mix
      bench-component: tiny
      bench-run: "{{ run_id }}"
  template:
    metadata:
      labels:
        app: benchmark-workload
        wikoion.dev/placement: managed
        bench-profile: prod-mix
        bench-component: tiny
        bench-run: "{{ run_id }}"
    spec:
      terminationGracePeriodSeconds: 0
      containers:
        - name: pause
          image: registry.k8s.io/pause:3.9
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 100m
              memory: 128Mi
---
