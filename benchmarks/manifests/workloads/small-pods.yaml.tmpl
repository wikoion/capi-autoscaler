# Small workload pods: 250m CPU / 256Mi memory
# Rendered by Jinja2 with: replicas, run_id
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bench-small-{{ run_id }}
  namespace: benchmark-workload
  labels:
    app: benchmark-workload
    bench-profile: small
    bench-run: "{{ run_id }}"
spec:
  replicas: {{ replicas }}
  selector:
    matchLabels:
      app: benchmark-workload
      bench-profile: small
      bench-run: "{{ run_id }}"
  template:
    metadata:
      labels:
        app: benchmark-workload
        wikoion.dev/placement: managed
        bench-profile: small
        bench-run: "{{ run_id }}"
    spec:
      terminationGracePeriodSeconds: 0
      containers:
        - name: pause
          image: registry.k8s.io/pause:3.9
          resources:
            requests:
              cpu: 250m
              memory: 256Mi
            limits:
              cpu: 250m
              memory: 256Mi
