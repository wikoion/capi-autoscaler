# Cost benchmark: unconstrained memory-leaning mix whose true-cost-optimal
# fleet is the reserved-priced r5.2xlarge pool. Discriminates autoscalers that
# chase real prices (cost annotations) from ones limited to public on-demand.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bench-cmix-web-{{ run_id }}
  namespace: benchmark-workload
  labels:
    app: benchmark-workload
    bench-profile: cost-mix
    bench-component: web
    bench-run: "{{ run_id }}"
spec:
  replicas: {{ web_replicas }}
  selector:
    matchLabels:
      app: benchmark-workload
      bench-profile: cost-mix
      bench-component: web
      bench-run: "{{ run_id }}"
  template:
    metadata:
      labels:
        app: benchmark-workload
        wikoion.dev/placement: managed
        bench-profile: cost-mix
        bench-component: web
        bench-run: "{{ run_id }}"
    spec:
      terminationGracePeriodSeconds: 0
      containers:
        - name: pause
          image: registry.k8s.io/pause:3.9
          resources:
            requests:
              cpu: 500m
              memory: 1Gi
            limits:
              cpu: 500m
              memory: 1Gi
---
