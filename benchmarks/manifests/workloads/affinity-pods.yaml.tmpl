# One per node when constrained: node-count floor at zero marginal cost for
# the solver. 2 cpu / 16Gi deliberately doesn't fit any 2-vCPU instance, so
# a stranded pod can't hide on a cheap small node.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bench-{{ profile }}-standalone-{{ run_id }}
  namespace: benchmark-workload
  labels:
    app: benchmark-workload
    bench-profile: {{ profile }}
    bench-component: standalone
    bench-run: "{{ run_id }}"
spec:
  replicas: {{ standalone_replicas }}
  selector:
    matchLabels:
      app: benchmark-workload
      bench-profile: {{ profile }}
      bench-component: standalone
      bench-run: "{{ run_id }}"
  template:
    metadata:
      labels:
        app: benchmark-workload
        wikoion.dev/placement: managed
        bench-profile: {{ profile }}
        bench-component: standalone
        bench-run: "{{ run_id }}"
    spec:
      terminationGracePeriodSeconds: 0
{% if constrained %}
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - topologyKey: kubernetes.io/hostname
              labelSelector:
                matchLabels:
                  bench-component: standalone
                  bench-run: "{{ run_id }}"
{% endif %}
      containers:
        - name: pause
          image: registry.k8s.io/pause:3.9
          resources:
            requests:
              cpu: 2
              memory: 16Gi
            limits:
              cpu: 2
              memory: 16Gi
