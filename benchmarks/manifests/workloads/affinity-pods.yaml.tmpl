# Zone keyed anti-affinity to db. Pinned to zones a/b so db always has a
# zone free of batch pods and neither side can wedge the other.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bench-{{ profile }}-batch-{{ run_id }}
  namespace: benchmark-workload
  labels:
    app: benchmark-workload
    bench-profile: {{ profile }}
    bench-component: batch
    bench-run: "{{ run_id }}"
spec:
  replicas: {{ batch_replicas }}
  selector:
    matchLabels:
      app: benchmark-workload
      bench-profile: {{ profile }}
      bench-component: batch
      bench-run: "{{ run_id }}"
  template:
    metadata:
      labels:
        app: benchmark-workload
        wikoion.dev/placement: managed
        bench-profile: {{ profile }}
        bench-component: batch
        bench-run: "{{ run_id }}"
    spec:
      terminationGracePeriodSeconds: 0
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: node.kubernetes.io/instance-type
                    operator: In
                    values:
                      - m6i.large
                  - key: topology.kubernetes.io/zone
                    operator: In
                    values:
                      - us-east-1a
                      - us-east-1b
{% if constrained %}
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - topologyKey: topology.kubernetes.io/zone
              labelSelector:
                matchLabels:
                  bench-component: db
                  bench-run: "{{ run_id }}"
{% endif %}
      containers:
        - name: pause
          image: registry.k8s.io/pause:3.9
          resources:
            requests:
              cpu: 500m
              memory: 1Gi
            limits:
              cpu: 500m
              memory: 1Gi
---
