# Inter-pod affinity benchmark: rendered as "heavy-constrained" (affinity
# terms on) or "unconstrained" (identical shapes and node pins, no inter-pod
# terms), so the delta between the two profiles is the cost of rule handling.
# All terms are required-only: the optimiser only models hard rules. Hostname
# keyed terms exercise what the controller translates today; zone keyed terms
# exercise the optimiser's AffinityGroup path (controller support to follow).
# Zone-keyed components pin to the zoned m6i.large pools so zone domains are
# well defined and the tainted control-plane node never counts as a domain.
# The api/memcache/standalone components are unpinned and memory-shaped
# (from colo-mix) so $/GiB decides their packing and the reserved-priced
# r5.2xlarge pool is the prize; standalone's one-per-node rule fragments
# greedy packers.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bench-{{ profile }}-web-{{ run_id }}
  namespace: benchmark-workload
  labels:
    app: benchmark-workload
    bench-profile: {{ profile }}
    bench-component: web
    bench-run: "{{ run_id }}"
spec:
  replicas: {{ web_replicas }}
  selector:
    matchLabels:
      app: benchmark-workload
      bench-profile: {{ profile }}
      bench-component: web
      bench-run: "{{ run_id }}"
  template:
    metadata:
      labels:
        app: benchmark-workload
        wikoion.dev/placement: managed
        bench-profile: {{ profile }}
        bench-component: web
        bench-run: "{{ run_id }}"
    spec:
      terminationGracePeriodSeconds: 0
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: node.kubernetes.io/instance-type
                    operator: In
                    values:
                      - m6i.large
{% if constrained %}
        # One web per node; also guarantees headroom for pair co-location
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - topologyKey: kubernetes.io/hostname
              labelSelector:
                matchLabels:
                  bench-component: web
                  bench-run: "{{ run_id }}"
{% endif %}
      containers:
        - name: pause
          image: registry.k8s.io/pause:3.9
          resources:
            requests:
              cpu: 500m
              memory: 512Mi
            limits:
              cpu: 500m
              memory: 512Mi
---
